<?xml version="1.0" encoding="utf-8"?>
<!-- T002: no Feldexa app data may leave the device through cloud backup or
     device-to-device transfer. allowBackup=false is the API 26-30 guard and
     also makes cross-platform transfer ineligible: Android's
     BackupEligibilityRules checks allowBackup before platform-specific-params.
     Cross-platform transfer (API 36.1+) is therefore not declared, because a
     valid declaration would require a real iOS bundleId/teamId identity that
     Feldexa does not have. These rules cover the Android 12+ cloud/D2D path. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
